# backend_v2/.env is separate from the repository-root .env used by backend/.
# Copy this file to backend_v2/.env for local overrides; do not put real secrets here.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=opencrm_v2
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

TIME_ZONE=UTC
FRONTEND_ORIGIN=http://localhost:8080

CACHE_URL=redis://127.0.0.1:6379/4
CELERY_BROKER_URL=redis://127.0.0.1:6379/5
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/6
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/7

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
TRUSTED_PROXY_COUNT=0
LOGIN_MAX_CONSECUTIVE_ATTEMPTS=10
LOGIN_LOCK_INTERVAL_SECONDS=60
