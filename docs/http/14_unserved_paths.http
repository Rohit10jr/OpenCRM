# 14 - the twenty dotted paths the frontend calls that nothing serves. Each answers 404
# today. This file exists so the gap is visible in the suite: when one of these is
# ported, its block goes red here, and its expectation should move to the real answer in
# the file that owns the feature.
#
# Found by scanning frontend/src for call('...') sites (docs/TESTING_GUIDE.md, "Gaps you
# will hit"). The guard in tests/test_phase3_endpoints.py matches only `url:` and
# `method:` keys, so these were invisible to it.
#
# The first ten break real buttons. The last ten are Desk plumbing the Vue app is
# written to tolerate failing.

@host = http://localhost:8000
@admin = Administrator
@admin_pwd = {{$dotenv ADMIN_PWD}}

### 0.1 login -> 200
# @name login
POST {{host}}/api/method/login
Content-Type: application/json

{"usr": "{{admin}}", "pwd": "{{admin_pwd}}"}

###
@token = {{login.response.body.$.message.access}}

# ---- product-breaking: a button in the UI errors ------------------------------------------------

### 1.1 Create Deal (Modals/DealModal.vue) -> 404
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/crm.fcrm.doctype.crm_deal.crm_deal.create_deal
Authorization: Bearer {{token}}
Content-Type: application/json

{"doc": {}}

### 1.2 Convert to Deal (Modals/ConvertToDealModal.vue, ListBulkActions.vue) -> 404
# The backend has crm_app.conversion.convert_to_deal; nothing exposes it at this path.
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/crm.fcrm.doctype.crm_lead.crm_lead.convert_to_deal
Authorization: Bearer {{token}}
Content-Type: application/json

{"lead": "x"}

### 1.3 the deal's contacts panel (pages/Deal.vue) -> 404
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/crm.fcrm.doctype.crm_deal.api.get_deal_contacts
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "x"}

