Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "funnel_conversion", "type": "funnel", "from_date": "2026-01-01", "to_date": "2026-12-31"}

### 2.17 without a token -> 401
# @expect $.exc_type == AuthenticationError
POST {{host}}/api/method/{{dash}}.get_chart
Content-Type: application/json

{"name": "total_leads", "type": "number"}

### 2.18 dates that do not parse -> 417, frappe.utils.getdate's sentence, frappe.bold included
# @expect $.exc_type == ValidationError
# @expect $.message == <strong>yesterday</strong> is not a valid date string.
POST {{host}}/api/method/{{dash}}.get_chart
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "total_leads", "type": "number", "from_date": "yesterday", "to_date": "soon"}

# ---- teardown ------------------------------------------------------------------------------

### 3.1 put the default layout back -> 200
# @expect $.message contains deals_by_salesperson
POST {{host}}/api/method/{{dash}}.reset_to_default
Authorization: Bearer {{token}}

### 3.2 -> ten tiles again
# @expect $.message count 10
POST {{host}}/api/method/{{dash}}.get_dashboard
Authorization: Bearer {{token}}
Content-Type: application/json

{}
