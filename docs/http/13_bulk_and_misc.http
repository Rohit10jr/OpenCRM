# 13 - delete_bulk_docs and its linked-document handling, the frappe.client built-ins not
# yet covered (get by filters, insert, get_list paging), Tag, Email Template, File's
# public/own-upload carve-outs, and the small endpoints that exist so the login and
# settings screens do not break: oauth_providers, exchange rate, onboarding, assignment
# rules.
#
# Expectations from crm/api/doc.py:796-837 (delete_bulk_docs: three messages, >10 items
# go to a background job), frappe/client.py, frappe/core/doctype/file/file.py:908-921
# (public files are public, your own upload is yours), crm/api/onboarding.py,
# crm/api/exchange_rate.py, crm/api/auth.py. Assignment Rule is a framework doctype the
# port does not model; its two endpoints answer as an unconfigured site would.
#
# The >10 path of delete_bulk_docs hands the batch to Celery, which has no worker in
# this setup, so it is not exercised here; the inline path is.

@host = http://localhost:8000
@admin = Administrator
@admin_pwd = {{$dotenv ADMIN_PWD}}
@sales = ada@example.com
@sales_pwd = {{$dotenv SALES_PWD}}
@manager = grace@example.com
@manager_pwd = {{$dotenv MANAGER_PWD}}
@org = {{host}}/api/resource/CRM%20Organization
@lead = {{host}}/api/resource/CRM%20Lead
@note = {{host}}/api/resource/FCRM%20Note
@file = {{host}}/api/resource/File

### 0.1 login as Administrator -> 200
# @name login
POST {{host}}/api/method/login
Content-Type: application/json

{"usr": "{{admin}}", "pwd": "{{admin_pwd}}"}

###
@token = {{login.response.body.$.message.access}}

### 0.2 login as the Sales Manager -> 200
# @name mlogin
POST {{host}}/api/method/login
Content-Type: application/json

{"usr": "{{manager}}", "pwd": "{{manager_pwd}}"}

###
@mtoken = {{mlogin.response.body.$.message.access}}

### 0.3 login as the Sales User -> 200
# @name slogin
POST {{host}}/api/method/login
Content-Type: application/json

{"usr": "{{sales}}", "pwd": "{{sales_pwd}}"}

###
@stoken = {{slogin.response.body.$.message.access}}

