# @expect $.data count 0
GET {{org}}?fields=["name"]&filters=[["name","like","ZZ %25"]]
Authorization: Bearer {{token}}

# ---- the framework plumbing the pages call on load -------------------------------------------------
#
# Four framework calls and one CRM call that are not about CRM records at all:
# frappe/apps.py:17-55 (the app switcher), frappe/core/doctype/user/user.py:783-792 (the
# time-zone dropdown), frappe/integrations/frappe_providers/frappecloud_billing.py:43-71
# (Frappe Cloud billing), the telemetry boot config - which does not exist in version-15,
# but the router calls it on every navigation - and crm/demo/api.py:clear_demo_data.
#
# No teardown: none of these writes anything. current_site_info and clear_demo_data both
# reproduce frappe.only_for, in its two different forms - one silent, one naming the roles
# - and both refusals are checked, because they are the only observable behaviour either
# endpoint has.

### 9.1 get_apps as Administrator -> 200, the CRM's own add_to_apps_screen entry (this is a one-app site)
# @expect $.message count 1
# @expect $.message[0].name == crm
GET {{host}}/api/method/frappe.apps.get_apps
Authorization: Bearer {{token}}

### 9.2 ...and for a Sales User too: check_app_permission passes on FCRM module access -> 200
# @expect $.message count 1
# @expect $.message[0].route == /crm
GET {{host}}/api/method/frappe.apps.get_apps
Authorization: Bearer {{stoken}}

### 9.3 get_timezones -> 200, the options PreferencesSettings.vue puts in the dropdown
# @expect $.message.timezones contains Asia/Kolkata
GET {{host}}/api/method/frappe.core.doctype.user.user.get_timezones
Authorization: Bearer {{token}}

### 9.4 current_site_info as Administrator -> 200, and empty: this port is never a Frappe Cloud site
# @expect $.message exists
GET {{host}}/api/method/frappe.integrations.frappe_providers.frappecloud_billing.current_site_info
Authorization: Bearer {{token}}

### 9.5 ...but System Manager only, so the Sales User -> 403 (only_for with message=False)
# @expect $.message == Not permitted
GET {{host}}/api/method/frappe.integrations.frappe_providers.frappecloud_billing.current_site_info
Authorization: Bearer {{stoken}}

### 9.6 boot_config -> 200, off until POSTHOG_PROJECT_ID and POSTHOG_HOST are both set
# @expect $.message.enabled == false
GET {{host}}/api/method/frappe.utils.telemetry.pulse.client.boot_config
Authorization: Bearer {{token}}

### 9.7 clear_demo_data as Administrator -> 200, and a no-op: no demo state is ever recorded here
POST {{host}}/api/method/crm.demo.api.clear_demo_data
Authorization: Bearer {{token}}

### 9.8 ...Sales Manager or System Manager only, so the Sales User -> 403 (only_for with message=True)
# @expect $.message == This action is only allowed for <strong>Sales Manager</strong>, <strong>System Manager</strong>
POST {{host}}/api/method/crm.demo.api.clear_demo_data
Authorization: Bearer {{stoken}}

# ---- the list view's bulk actions, and the composer's template renderer --------------------------
#
# frappe/desk/form/assign_to.py:148-156 and :191-201 (assign and clear assignment over a
# selection - AssignmentModal.vue:157-170 and ListBulkActions.vue:145-156),
# frappe/desk/doctype/bulk_update/bulk_update.py:54-124 (the bulk edit dialog,
# EditValueModal.vue:109-125) and
# frappe/email/doctype/email_template/email_template.py:52-58 (EmailEditor.vue:297-313).
#
# Two bands of submit_cancel_or_update_docs are not exercised here and are covered by
# backend/tests/test_bulk_actions.py instead: the >500 refusal, which needs a generated
# list of 501 names that no static file should carry, and the 20-500 enqueue band, which
# hands the batch to Celery and there is no worker in this setup.
#
# Section 3's Email Template is renamed to "ZZ Welcome 2" and deleted by the section 6
# teardown, so this section makes one of its own and deletes it at the end, with the two
# leads.
#
# The leads are named "ZZ Bulk Batch ..." so the leftover sweep in section 0 reclaims them
# if a run stops half way.

### 10.1 a leftover template from an interrupted run -> 200|404
DELETE {{host}}/api/resource/Email%20Template/ZZ%20Render
Authorization: Bearer {{token}}

### 10.2 a lead to act on -> 201
# @name b1
POST {{lead}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"first_name": "ZZ Bulk Batch A", "lead_owner": "{{admin}}"}

###
@b1n = {{b1.response.body.$.data.name}}

### 10.3 and a second -> 201
# @name b2
POST {{lead}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"first_name": "ZZ Bulk Batch B", "lead_owner": "{{admin}}"}

###
@b2n = {{b2.response.body.$.data.name}}

### 10.4 assign both to ada in one call -> 200, and a null body: upstream's add_multiple returns nothing
# @expect $.message == null
# `name` is the JSON-encoded *list*, which is the odd shape AssignmentModal.vue sends;
# bulk_assign and re_assign ride along with it and upstream's `add` reads neither.
POST {{host}}/api/method/frappe.desk.form.assign_to.add_multiple
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Lead", "name": "[\"{{b1n}}\", \"{{b2n}}\"]", "assign_to": ["{{sales}}"], "bulk_assign": true, "re_assign": true}

### 10.5 the assignment landed on the first of them -> 200
# @expect $.message contains {{sales}}
GET {{host}}/api/method/crm.api.doc.get_assigned_users?doctype=CRM%20Lead&name={{b1n}}
Authorization: Bearer {{token}}

### 10.6 ...and on the second -> 200
# @expect $.message contains {{sales}}
GET {{host}}/api/method/crm.api.doc.get_assigned_users?doctype=CRM%20Lead&name={{b2n}}
Authorization: Bearer {{token}}

### 10.7 clear the assignment on both -> 200, null again
# @expect $.message == null
# `ignore_permissions` is what ListBulkActions.vue sends and buys nothing: upstream's
# remove_multiple does not accept the argument, so the framework drops it there too.
POST {{host}}/api/method/frappe.desk.form.assign_to.remove_multiple
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Lead", "names": "[\"{{b1n}}\", \"{{b2n}}\"]", "ignore_permissions": true}

### 10.8 every open assignment is gone, the owner's own included -> 200, empty
# @expect $.message count 0
GET {{host}}/api/method/crm.api.doc.get_assigned_users?doctype=CRM%20Lead&name={{b1n}}
Authorization: Bearer {{token}}

### 10.9 bulk edit a field on both -> 200 and an empty `failed` list
# @expect $.message count 0
# Under 20 names runs in the request and answers with the names that did not go through.
# `next_step` is a Deal field, so the lead equivalent (`job_title`) is what is set here.
POST {{host}}/api/method/frappe.desk.doctype.bulk_update.bulk_update.submit_cancel_or_update_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Lead", "docnames": ["{{b1n}}", "{{b2n}}"], "action": "update", "data": {"job_title": "ZZ Batch Edited"}}

### 10.10 -> the field changed on the first
# @expect $.data.job_title == ZZ Batch Edited
GET {{lead}}/{{b1n}}
Authorization: Bearer {{token}}

### 10.11 -> and on the second
# @expect $.data.job_title == ZZ Batch Edited
GET {{lead}}/{{b2n}}
Authorization: Bearer {{token}}

### 10.12 "submit" fails every document -> 200, both names come back
# @expect $.message count 2
# Nothing in this port is submittable: there is no docstatus, so there is no document
# submit or cancel can apply to. Upstream reaches the same answer by raising inside
# doc.submit() and catching it per document.
POST {{host}}/api/method/frappe.desk.doctype.bulk_update.bulk_update.submit_cancel_or_update_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Lead", "docnames": ["{{b1n}}", "{{b2n}}"], "action": "submit"}

###
# A literal `{`. The runner substitutes every {{name}} it finds and errors on one it does
# not know, so a Jinja placeholder in a template body has to be assembled rather than typed.
@lb = {

### 10.13 a template of this section's own -> 201
POST {{host}}/api/resource/Email%20Template
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "ZZ Render", "subject": "Welcome aboard, {{lb}}{{lb}} first_name }}", "response": "<p>Hello {{lb}}{{lb}} first_name }} of {{lb}}{{lb}} organization }}.</p>", "reference_doctype": "CRM Lead"}

### 10.14 the document's fields are the template's variables -> 200
# @expect $.message.subject == Welcome aboard, ZZ Bulk Batch A
# @expect $.message.message contains Hello ZZ Bulk Batch A
# The composer sends the whole lead as `doc`, and upstream renders against that dict
# directly - so a template says {{lb}}{{lb}} first_name }}, not {{lb}}{{lb}} doc.first_name }}.
POST {{host}}/api/method/frappe.email.doctype.email_template.email_template.get_email_template
Authorization: Bearer {{token}}
Content-Type: application/json

{"template_name": "ZZ Render", "doc": {"first_name": "{{b1.response.body.$.data.first_name}}"}}

### 10.15 a name the document does not carry comes back as its own placeholder -> 200
# @expect $.message.message contains {{lb}}{{lb}} organization }}
# get_jenv sets undefined=DebugUndefined (frappe/utils/jinja.py:35): the gap is shown to
# the user to fill in, rather than raising or silently rendering as nothing.
POST {{host}}/api/method/frappe.email.doctype.email_template.email_template.get_email_template
Authorization: Bearer {{token}}
Content-Type: application/json

{"template_name": "ZZ Render", "doc": {"first_name": "Ada"}}

### 10.16 a template that does not exist -> 404
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/frappe.email.doctype.email_template.email_template.get_email_template
Authorization: Bearer {{token}}
Content-Type: application/json

{"template_name": "ZZ No Such Template", "doc": {"first_name": "Ada"}}

### 10.17 a Sales User may render one too: no row rule guards Email Template -> 200
# @expect $.message.subject == Welcome aboard, Ada
POST {{host}}/api/method/frappe.email.doctype.email_template.email_template.get_email_template
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"template_name": "ZZ Render", "doc": {"first_name": "Ada"}}

