# ---- frappe.client.get by filters, insert, get_list paging ----------------------------------------

### 2.1 frappe.client.insert -> the created document
# @expect $.message.name == ZZ Inserted
# @expect $.message.owner == Administrator
POST {{host}}/api/method/frappe.client.insert
Authorization: Bearer {{token}}
Content-Type: application/json

{"doc": {"doctype": "CRM Organization", "organization_name": "ZZ Inserted", "website": "https://inserted.example"}}

### 2.2 the doc may arrive as a JSON string -> 409 now, because it already exists (proves it was parsed)
# @expect $.exc_type == DuplicateEntryError
POST {{host}}/api/method/frappe.client.insert
Authorization: Bearer {{token}}
Content-Type: application/json

{"doc": "{\"doctype\": \"CRM Organization\", \"organization_name\": \"ZZ Inserted\"}"}

### 2.3 without a doctype -> 417
# @expect $.message == doctype is required
POST {{host}}/api/method/frappe.client.insert
Authorization: Bearer {{token}}
Content-Type: application/json

{"doc": {"organization_name": "ZZ No Doctype"}}

### 2.4 insert enforces create permission: a Sales User cannot mint a notification -> 403
# @expect $.exc_type == PermissionError
POST {{host}}/api/method/frappe.client.insert
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"doc": {"doctype": "CRM Notification", "type": "Mention", "to_user": "{{manager}}", "from_user": "{{sales}}", "message": "ZZ"}}

### 2.5 frappe.client.get by filters instead of a name -> the document
# @expect $.message.name == ZZ Inserted
# @expect $.message.website == https://inserted.example
POST {{host}}/api/method/frappe.client.get
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "filters": {"website": "https://inserted.example"}}

### 2.6 filters matching nothing -> 404
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/frappe.client.get
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "filters": {"website": "https://nobody.example"}}

### 2.7 neither name nor filters -> 417
# @expect $.message == name or filters is required
POST {{host}}/api/method/frappe.client.get
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization"}

### 2.8 an unknown doctype -> 404
# @expect $.exc_type == DoesNotExistError
POST {{host}}/api/method/frappe.client.get
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "No Such Doctype", "name": "x"}

### 2.9 get_list with or_filters, ordering and paging -> the second page of one
# @expect $.message count 1
POST {{host}}/api/method/frappe.client.get_list
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "fields": ["name"], "or_filters": [["name", "=", "ZZ Inserted"], ["name", "=", "Globex"]], "order_by": "name asc", "limit_start": 1, "limit_page_length": 1}

# ---- tags and email templates (prompt-named doctypes) -------------------------------------------

### 3.1 a tag, named by the client -> 201
# @expect $.data.name == ZZ Hot
POST {{host}}/api/resource/Tag
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "ZZ Hot"}

### 3.2 the same tag again -> 409
# @expect $.exc_type == DuplicateEntryError
POST {{host}}/api/resource/Tag
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "ZZ Hot"}

### 3.3 an email template -> 201; enabled by default
# @expect $.data.name == ZZ Welcome
# @expect $.data.enabled == true
POST {{host}}/api/resource/Email%20Template
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "ZZ Welcome", "subject": "Welcome aboard", "response": "<p>Thanks for your interest.</p>", "reference_doctype": "CRM Lead"}

### 3.4 renaming an unreferenced document works (finding 13 is about referenced ones) -> the new name
# @expect $.message == ZZ Welcome 2
POST {{host}}/api/method/frappe.client.rename_doc
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "Email Template", "old_name": "ZZ Welcome", "new_name": "ZZ Welcome 2"}

### 3.5 the old name is gone -> 404
# @expect $.exc_type == DoesNotExistError
GET {{host}}/api/resource/Email%20Template/ZZ%20Welcome
Authorization: Bearer {{token}}

### 3.6 -> the new one carries the content
# @expect $.data.subject == Welcome aboard
GET {{host}}/api/resource/Email%20Template/ZZ%20Welcome%202
Authorization: Bearer {{token}}

### 3.7 a Sales User may read templates (the composer lists them) -> 200
# @expect $.data.name == ZZ Welcome 2
GET {{host}}/api/resource/Email%20Template/ZZ%20Welcome%202
Authorization: Bearer {{stoken}}

# ---- File: the two carve-outs upstream makes (file.py:916, 919) ----------------------------------

### 4.1 a lead the manager owns, invisible to ada -> 201
# @name lead_req
POST {{lead}}
Authorization: Bearer {{mtoken}}
Content-Type: application/json

{"first_name": "ZZ Bulk File Lead", "lead_owner": "{{manager}}"}

###
@lead_name = {{lead_req.response.body.$.data.name}}

### 4.2 a PUBLIC file attached to it -> 201
# @name pub_req
POST {{file}}
Authorization: Bearer {{mtoken}}
Content-Type: application/json

{"file_name": "zz-logo.png", "file_url": "/files/zz-logo.png", "is_private": 0, "attached_to_doctype": "CRM Lead", "attached_to_name": "{{lead_name}}"}

###
@pub = {{pub_req.response.body.$.data.name}}

### 4.3 a public file is readable by anyone, whatever it hangs off (file.py:916) -> 200
# @expect $.data.file_url == /files/zz-logo.png
GET {{file}}/{{pub}}
Authorization: Bearer {{stoken}}

### 4.4 ...but not writable by someone who cannot write the document -> 403
# @expect $.exc_type == PermissionError
PUT {{file}}/{{pub}}
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"file_name": "zz-renamed.png"}

### 4.5 ada uploads a private file with no attachment -> 201
# @name own_req
POST {{file}}
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"file_name": "zz-mine.pdf", "file_url": "/private/files/zz-mine.pdf", "is_private": 1}

###
@own = {{own_req.response.body.$.data.name}}

### 4.6 your own upload is yours (file.py:919) -> 200
# @expect $.data.owner == ada@example.com
GET {{file}}/{{own}}
Authorization: Bearer {{stoken}}

### 4.6b a private file attached to nothing is its owner's alone (file.py:932-951 falls to return False) -> 403
# The manager sees every lead, but this file hangs off nothing, so there is no document
# to reach it through.
# @expect $.exc_type == PermissionError
GET {{file}}/{{own}}
Authorization: Bearer {{mtoken}}

### 4.6c ...and it is not in her list either -> 200, absent
# @expect $.data excludes {{own}}
GET {{file}}?fields=["name"]&filters=[["name","=","{{own}}"]]
Authorization: Bearer {{mtoken}}

### 4.7 ...and may even attach it to a lead she cannot see -> 200: upstream's own-upload carve-out
# (file.py:919) is checked BEFORE the attached document, so the owner keeps write on the File row.
# The row does not grant her the lead; it only records where the file hangs.
# @expect $.data.attached_to_name == {{lead_name}}
PUT {{file}}/{{own}}
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"attached_to_doctype": "CRM Lead", "attached_to_name": "{{lead_name}}"}

### 4.8 once attached, the file is reachable through its document: the manager reads the lead, so the file -> 200
# @expect $.data.attached_to_name == {{lead_name}}
GET {{file}}/{{own}}
Authorization: Bearer {{mtoken}}

