DELETE {{host}}/api/resource/Tag/ZZ%20Hot
Authorization: Bearer {{token}}

### 6.6 -> 200
DELETE {{org}}/ZZ%20Inserted
Authorization: Bearer {{token}}

### 6.7 -> 200
DELETE {{note}}/{{n1}}
Authorization: Bearer {{token}}

