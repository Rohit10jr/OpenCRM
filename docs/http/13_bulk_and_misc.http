GET {{note}}?fields=["name"]&filters=[["title","like","ZZ Bulk%25"]]
Authorization: Bearer {{token}}

### 0.14 -> 200|404
DELETE {{note}}/{{old_n.response.body.$.data[0].name}}
Authorization: Bearer {{token}}

### 0.15 -> 200|404
DELETE {{note}}/{{old_n.response.body.$.data[1].name}}
Authorization: Bearer {{token}}

### 0.16 leftover tag, templates -> 200|404
DELETE {{host}}/api/resource/Tag/ZZ%20Hot
Authorization: Bearer {{token}}

### 0.17 -> 200|404
DELETE {{host}}/api/resource/Email%20Template/ZZ%20Welcome
Authorization: Bearer {{token}}

### 0.18 -> 200|404
