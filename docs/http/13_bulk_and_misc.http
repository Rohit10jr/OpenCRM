# @expect $.message excludes "Administrator"
# @expect $.message contains ada@example.com
POST {{host}}/api/method/frappe.desk.search.search_link
Authorization: Bearer {{stoken}}
Content-Type: application/json

{"doctype": "User", "txt": "a", "page_length": 50}

