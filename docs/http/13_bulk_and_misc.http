Authorization: Bearer {{token}}

### 5.5 get_first_deal -> the oldest deal's name
# @expect $.message contains CRM-DEAL-
POST {{host}}/api/method/crm.api.onboarding.get_first_deal
Authorization: Bearer {{token}}

### 5.6 get_assignment_rules_list -> [] (Assignment Rule is a framework doctype the port does not model)
# @expect $.message count 0
POST {{host}}/api/method/crm.api.assignment_rule.get_assignment_rules_list
Authorization: Bearer {{token}}

### 5.7 duplicate_assignment_rule refuses rather than faking a rule -> 417 (port decision)
# @expect $.message == Assignment Rule is not available in this deployment
POST {{host}}/api/method/crm.api.assignment_rule.duplicate_assignment_rule
Authorization: Bearer {{token}}
Content-Type: application/json

{"docname": "x", "new_name": "y"}

