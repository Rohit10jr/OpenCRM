# ---- delete_bulk_docs ----------------------------------------------------------------------------

### 1.1 three organizations -> 201
POST {{org}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"organization_name": "ZZ Bulk 1"}

### 1.2 -> 201
POST {{org}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"organization_name": "ZZ Bulk 2"}

### 1.3 -> 201
POST {{org}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"organization_name": "ZZ Bulk 3"}

### 1.4 delete two of them -> "success", upstream's literal return value
# @expect $.message == success
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "items": ["ZZ Bulk 1", "ZZ Bulk 2"]}

### 1.5 gone -> 404
# @expect $.exc_type == DoesNotExistError
GET {{org}}/ZZ%20Bulk%201
Authorization: Bearer {{token}}

### 1.6 -> the third survived
# @expect $.data.name == ZZ Bulk 3
GET {{org}}/ZZ%20Bulk%203
Authorization: Bearer {{token}}

### 1.7 items as a JSON string are accepted (the frontend sends them stringified) -> "success"
# @expect $.message == success
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "items": "[\"ZZ Bulk 3\"]"}

### 1.8 no items -> 417, crm/api/doc.py:803 verbatim
# @expect $.message == Items are required
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "items": []}

### 1.9 no doctype -> 417, :800 verbatim
# @expect $.message == Doctype is required
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "", "items": ["x"]}

### 1.10 items that are not a list -> 417, :807 verbatim
# @expect $.message == Items must be a list
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "items": {"name": "x"}}

### 1.11 names that no longer exist are dropped, not an error -> "success"
# @expect $.message == success
POST {{host}}/api/method/crm.api.doc.delete_bulk_docs
Authorization: Bearer {{token}}
Content-Type: application/json

{"doctype": "CRM Organization", "items": ["ZZ Bulk 1", "ZZ Nobody"]}

