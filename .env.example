# Template — copy to .env and fill in. Never commit a real .env.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=          # python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=opencrm
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis — Celery broker + Channels layer
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CHANNELS_REDIS_URL=redis://localhost:6379/2

# JWT (PORT_PLAN.md §10)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=5
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend dev server — CORS origin
FRONTEND_ORIGIN=http://localhost:8080

# Email. EMAIL_BACKEND is the transport of the config account below and of nothing else:
# a saved Email Account sends through its own SMTP details.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# The config account (docs/FINDINGS.md 79): upstream's site_config.json mail keys
# (email_account.py:563-590), the account that carries system mail - invitations, password
# resets - and any lead mail no saved Email Account matches. It exists only while
# EMAIL_HOST is set, like upstream's mail_server; with the console backend above the host
# is never contacted and the mail prints in the Celery worker's terminal.
EMAIL_HOST=localhost
# mail_login / mail_password. Leave EMAIL_HOST_USER empty for no SMTP authentication.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Unset, EMAIL_USE_TLS is on when EMAIL_HOST_USER is set (upstream's use_tls fallback) and
# EMAIL_PORT is 465 with SSL, 587 with TLS, else 25. EMAIL_USE_SSL=True turns TLS off
# whatever this says: a relay offers one or the other, and Django refuses both.
# EMAIL_USE_TLS=True
# EMAIL_PORT=587
EMAIL_USE_SSL=False
# auto_email_id: the address system mail is From. Set it explicitly when EMAIL_HOST_USER is
# not an address - upstream falls back to mail_login the same way.
DEFAULT_FROM_EMAIL=notifications@example.com
# email_sender_name: the display name on system mail, "Frappe <notifications@...>".
EMAIL_SENDER_NAME=Frappe
# always_use_account_email_id_as_sender: on, a lead's mail is From DEFAULT_FROM_EMAIL with
# the user's display name, for a relay that only accepts its own sender.
EMAIL_ALWAYS_USE_ACCOUNT_EMAIL_ID_AS_SENDER=False

# Integrations — all OFF by default (specs/PHASE_7_INTEGRATIONS.md)
ENABLE_ERPNEXT=False
ENABLE_TWILIO=False
ENABLE_EXOTEL=False
ENABLE_FACEBOOK_LEAD_SYNC=False
ENABLE_WHATSAPP=False

# Exchange rates — ON by default, as upstream (docs/FINDINGS.md 63). A deal or organization
# in another currency asks the provider from Settings -> Dashboard for its rate on save.
# False on a site with no outbound internet: every rate is then 1.
ENABLE_EXCHANGE_RATE_API=True
